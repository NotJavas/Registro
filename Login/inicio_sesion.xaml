<Window x:Class="Registro.Login.InicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de Sesión" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#37393f">

    <Border Background="#2C2F33" CornerRadius="10"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="320" Height="400">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" Opacity="0.3" BlurRadius="10"/>
        </Border.Effect>

        <StackPanel Margin="20">
            <Label Content="BIENVENIDO" 
                   Style="{StaticResource TitleLabel}"
                   HorizontalAlignment="Center"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,20"/>

            <!-- Usuario -->
            <Label Content="Usuario" Style="{StaticResource TextLabel}" Margin="0,10,0,5"/>
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="M12,12A5,5 0 0,1 7,7A5,5 0 0,1 12,2A5,5 0 0,1 17,7A5,5 0 0,1 12,12M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                      Fill="White" Width="16" Height="16" Stretch="Uniform" 
                      VerticalAlignment="Center" Margin="5,0,10,0"/>
                <ComboBox x:Name="ComboBoxUsuarios" 
                          SelectionChanged="ComboBoxUsuarios_SelectionChanged"
                          Style="{StaticResource ComboBox}"
                          IsEditable="True"
                          TextBoxBase.TextChanged="ComboBoxUsuarios_TextChanged"/>
            </DockPanel>

            <!-- Clave -->
            <Label Content="Contraseña" Style="{StaticResource TextLabel}" Margin="0,10,0,5"/>
            <!-- Se mantiene el Grid aquí porque es la herramienta ideal para superponer 
                 el PasswordBox y el TextBox, permitiendo alternar su visibilidad 
                 en el mismo espacio. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="M12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8V10H6V8H18M18,6H6C4.89,6 4,6.89 4,8V17A2,2 0 0,0 6,19H18A2,2 0 0,0 20,17V8C20,6.89 19.1,6 18,6Z" 
                      Fill="White" Width="16" Height="16" Stretch="Uniform" 
                      VerticalAlignment="Center" Margin="5,0,10,0"/>
                <PasswordBox x:Name="TxtClave" Grid.Column="1" Style="{StaticResource PasswordBox}"/>
                <TextBox x:Name="TxtClaveVisible" Grid.Column="1" Style="{StaticResource TextBox}" Visibility="Collapsed"/>
            </Grid>

            <CheckBox x:Name="CheckBoxMostrarClave"
                      Content="Mostrar contraseña"
                      Foreground="White"
                      Margin="0,10,0,0"
                      Click="CheckBoxMostrarClave_Click"
                      VerticalContentAlignment="Center"/>

            <Button x:Name="BotonLogin"
                    Content="Iniciar Sesión"
                    Style="{StaticResource LoginButton}"
                    Click="BotonLogin_Click"
                    Margin="0,30,0,0"/>
        </StackPanel>
    </Border>
</Window>
